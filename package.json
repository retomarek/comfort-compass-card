{
  "name": "comfort-compass-card",
  "version": "0.2.0",
  "description": "A Home Assistant dashboard card that shows how the days split into in range, too warm, too humid, too dry or too cold.",
  "type": "module",
  "source": "src/comfort-compass-card.js",
  "scripts": {
    "build": "parcel build --no-source-maps --no-cache",
    "watch": "parcel watch",
    "screenshots": "node scripts/screenshots.mjs",
    "social-preview": "node scripts/social-preview.mjs",
    "visual-check": "node scripts/visual-check.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check-shared": "node scripts/check-shared.mjs"
  },
  "targets": {
    "default": {
      "distDir": "dist",
      "publicUrl": "./",
      "includeNodeModules": true
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "parcel": "^2.8.3",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.16.0",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "lit": "^3.3.0"
  }
}
